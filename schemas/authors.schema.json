{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"authors": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"slug": {
						"type": "string",
						"minLength": 1
					},
					"label": {
						"type": "string",
						"minLength": 1
					},
					"description": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"slug",
					"label"
				]
			}
		}
	},
	"required": [
		"authors"
	]
}
